# Copy this file to `.env` (same folder) and fill in what you have. Restart the app after changes.
# Every key is optional except AI_API_KEY (needed for resume tips, company summaries, interview prep).

# --- AI (needed for resume tips, company briefing, interview prep) ---
# Paste ONE key below; the provider is detected from the key automatically.
#   Google Gemini (free, recommended): https://aistudio.google.com/apikey   -> key starts with AIza
#   Groq (free, very fast):            https://console.groq.com/keys        -> key starts with gsk_
#   OpenRouter (free models):          https://openrouter.ai/keys           -> key starts with sk-or-
#   OpenAI (paid):                     https://platform.openai.com/api-keys -> key starts with sk-
AI_API_KEY=
# Optional overrides: AI_PROVIDER=gemini|groq|openrouter|ollama|openai, AI_MODEL=<model name>, AI_BASE_URL=<url>
AI_PROVIDER=
AI_MODEL=

# --- HR email lookup (optional, free tier: 25 searches/month) --- https://hunter.io/api-keys
HUNTER_API_KEY=

# --- Extra job sources (optional, all have free tiers) ---
# Adzuna: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=
# JSearch (Google for Jobs: LinkedIn/Naukri/Indeed/Glassdoor listings): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
# Free JSearch plan is ~200 requests/month; 6 per daily scan stays inside it.
JSEARCH_MAX_REQUESTS_PER_SCAN=6

# --- Behaviour ---
# Daily scan time is changed in the app (Settings page). Timezone for the schedule:
TIMEZONE=Asia/Kolkata
# Unofficial scrapers (LinkedIn guest search, Naukri, Hirist). Set to false for a commercial deployment
# unless you have permission from those sites. Individual sources can also be toggled in Settings.
ENABLE_UNOFFICIAL_SOURCES=true
# Ignore postings older than this many days
MAX_JOB_AGE_DAYS=30
